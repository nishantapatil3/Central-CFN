{
  "id": "cfn-enhanced-capture",
  "name": "CFN Enhanced Capture (Read + Write)",
  "version": "2.1.0",
  "description": "Bidirectional CFN integration: writes conversations to CFN and reads context to enhance agent replies",
  "entry": "./cfn-enhanced-capture.ts",
  "openclaw": {
    "minVersion": "2024.1.0"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "cfnNodeUrl": {
        "type": "string",
        "description": "CFN node URL",
        "default": "http://nispatil-m-qlpj.local:9002"
      },
      "workspaceId": {
        "type": "string",
        "description": "Workspace ID"
      },
      "masId": {
        "type": "string",
        "description": "Multi-Agentic System ID"
      },
      "enableCfnRead": {
        "type": "boolean",
        "description": "Enable CFN read enhancement",
        "default": true
      },
      "cfnReadMinReplyLength": {
        "type": "number",
        "description": "Minimum reply length to trigger CFN enhancement",
        "default": 100
      }
    },
    "additionalProperties": false
  }
}
