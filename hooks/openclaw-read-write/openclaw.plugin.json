{
  "id": "cfn-enhanced-capture",
  "name": "CFN OpenClaw Plugin (Read + Write)",
  "version": "2.1.0",
  "description": "Uses OpenClaw hooks to read from and write to central CFN shared memory",
  "entry": "./cfn-enhanced-capture.ts",
  "openclaw": {
    "minVersion": "2024.1.0"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "cfnNodeUrl": {
        "type": "string",
        "description": "Central CFN node URL",
        "default": "http://nispatil-m-qlpj.local:9002"
      },
      "workspaceId": {
        "type": "string",
        "description": "Workspace ID"
      },
      "masId": {
        "type": "string",
        "description": "Multi-Agentic System ID"
      },
      "enableCfnRead": {
        "type": "boolean",
        "description": "Enable reading from central CFN shared memory",
        "default": true
      },
      "cfnReadMinReplyLength": {
        "type": "number",
        "description": "Minimum query length to trigger reading from central CFN shared memory",
        "default": 100
      }
    },
    "additionalProperties": false
  }
}
